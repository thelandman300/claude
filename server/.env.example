# Copy to .env (or export these) before running `npm start`.

# Required — your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model for the concierge. Defaults to claude-opus-4-8.
# For higher-volume, lower-cost chat consider claude-sonnet-4-6 or claude-haiku-4-5.
# CONCIERGE_MODEL=claude-opus-4-8

# Optional — port (default 8000) and where captured leads are appended.
# PORT=8000
# LEADS_FILE=./leads.jsonl
